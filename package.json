{
  "name": "react-image-annotation-v2",
  "version": "1.2.0",
  "author": "Updated by Donatas, Original by Arian Allenson Valdez <arianallensonv@gmail.com> (http://arianv.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/donpui/react-image-annotation-v2"
  },
  "main": "./dist/react-image-annotation-v2.cjs",
  "module": "./dist/react-image-annotation-v2.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-image-annotation-v2.mjs",
      "require": "./dist/react-image-annotation-v2.cjs",
      "default": "./dist/react-image-annotation-v2.mjs"
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "react": "^19.2.7",
    "react-doctor": "latest",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "styled-components": "^6.4.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "styled-components": "^5.0.0 || ^6.0.0"
  },
  "description": "react-image-annotation React component",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react-component"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && vite build && node scripts/prepare-package.mjs",
    "deploy": "gh-pages -d demo/dist",
    "clean": "rm -rf dist es lib umd demo/dist",
    "start": "bun run build && vite --config vite.demo.config.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "doctor": "react-doctor "
  }
}
